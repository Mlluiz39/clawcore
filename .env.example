# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Em Docker, para alcançar um gateway rodando na máquina host:
#   OPENAI_BASE_URL=http://host.docker.internal:30128/v1

# Web Panel (REQUIRED)
JWT_SECRET=your-strong-secret-here
WEB_AUTH_PASSWORD=sua_senha_aqui
WEB_PORT=8080

# Produção: domínio público apontado para a VPS (TLS automático via Caddy)
SITE_DOMAIN=clawcore.seudominio.com

# CORS — OBRIGATÓRIO. Origem exata do painel; o backend recusa o boot se faltar
# ou se for "*". Em dev local use http://localhost:5173
CORS_ORIGIN=https://clawcore.seudominio.com

# Quantos proxies confiar ao ler X-Forwarded-For (afeta rate limit e logs).
# O compose padrão tem 2 na frente do backend: Caddy → nginx.
# Com npm run dev local (sem proxy), use 0.
TRUST_PROXY=2

# Agent config
MAX_CONTEXT_MESSAGES=20
MAX_AGENT_ITERATIONS=12

# Ferramenta run_command (executa shell no host). Mantenha false em produção.
ENABLE_SHELL_TOOL=false

# Integração WhatsApp via Baileys. Desligado por default: ligue só quando for
# parear o aparelho (a ferramenta whatsapp também só aparece quando true).
WHATSAPP_ENABLED=false

# Voice / Audio
TTS_VOICE=pt-BR-ThalitaMultilingualNeural

# Credencial do gogcli (opcional — só se a skill gog for usada)
GOG_KEYRING_PASSWORD=
