{
  "name": "clawcore",
  "version": "2.0.0",
  "description": " A empresa MlluizDevtech criou o Claw Core \u2014 Personal AI Agent",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:offline",
    "test:offline": "npm run test:workspace && npm run test:reconstruction && npm run test:stream-filter && npm run test:migrations",
    "test:workspace": "tsx tests/project-workspace-test.ts",
    "test:reconstruction": "tsx tests/surething-reconstruction-test.ts",
    "test:stream-filter": "tsx tests/stream-filter-test.ts",
    "test:surething": "tsx --env-file=.env tests/surething-motor-test.ts",
    "test:prospector": "tsx --env-file=.env tests/prospector-test.ts",
    "test:all": "npm run test:offline && npm run test:surething && npm run test:prospector",
    "backup": "./scripts/backup-db.sh",
    "test:migrations": "tsx tests/migrations-test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "edge-tts-universal": "^1.3.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "libsignal": {
      "protobufjs": "^7.6.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0"
  }
}
